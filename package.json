{
  "name": "siyuan-github-sync",
  "version": "1.0.0",
  "description": "SiYuan plugin to sync notes with a GitHub repository via the GitHub REST API",
  "scripts": {
    "dev": "webpack --config webpack.config.js --mode development --watch",
    "build": "webpack --config webpack.config.js --mode production",
    "lint": "eslint src --ext .ts",
    "commit": "cz"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@octokit/types": "^18.0.0",
    "@types/node": "^20.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.2",
    "esbuild": "^0.28.2",
    "esbuild-loader": "^4.2.2",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "mini-css-extract-plugin": "^2.9.2",
    "sass": "^1.80.4",
    "sass-loader": "^16.0.4",
    "siyuan": "^1.2.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.68.0",
    "webpack": "^5.95.0",
    "webpack-cli": "^5.1.4",
    "zip-webpack-plugin": "^4.0.1"
  },
  "keywords": [
    "siyuan",
    "plugin",
    "github",
    "sync"
  ],
  "license": "MIT",
  "dependencies": {
    "argon2-wasm": "^0.9.0",
    "jiti": "^2.7.0",
    "path-browserify": "^1.0.1",
    "scrypt-js": "^3.0.1"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true
  }
}
